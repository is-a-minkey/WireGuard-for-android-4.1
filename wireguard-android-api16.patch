@@ -19,6 +19,49 @@ char *strchrnul(const char *s, int c)
 }
 #endif
 
+#if defined(__ANDROID_MIN_SDK_VERSION__) && __ANDROID_MIN_SDK_VERSION__ < 18
+#undef FILE_IS_EMPTY
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/types.h>
+
+ssize_t getline(char **lineptr, size_t *n, FILE *stream)
+{
+        size_t len = 0;
+        int c;
+
+        if (!lineptr || !n || !stream) {
+                errno = EINVAL;
+                return -1;
+        }
+        if (!*lineptr || !*n) {
+                char *p = realloc(*lineptr, 128);
+                if (!p)
+                        return -1;
+                *lineptr = p;
+                *n = 128;
+        }
+        while ((c = getc(stream)) != EOF) {
+                if (len + 2 > *n) {
+                        size_t new_size = *n * 2;
+                        char *p = realloc(*lineptr, new_size);
+                        if (!p)
+                                return -1;
+                        *lineptr = p;
+                        *n = new_size;
+                }
+                (*lineptr)[len++] = (char)c;
+                if (c == '\n')
+                        break;
+        }
+        if (!len)
+                return -1;
+        (*lineptr)[len] = '\0';
+        return (ssize_t)len;
+}
+#endif
+
 #ifdef FILE_IS_EMPTY
 #undef FILE_IS_EMPTY
 static char ____x __attribute__((unused));
